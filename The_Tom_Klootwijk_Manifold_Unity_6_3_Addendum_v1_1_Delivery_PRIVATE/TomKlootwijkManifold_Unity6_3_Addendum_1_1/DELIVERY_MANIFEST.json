  "formal_core": {
    "product_literal": "K_TK(r) = Product_{i=0}^6 S^1(r_i), r_i > 0",
    "implicit_literal": "K_TK(r) = {x in R^14 : x_(2i)^2 + x_(2i+1)^2 = r_i^2, i=0,...,6}",
    "spatial_dimension": 7,
    "ambient_dimension": 14,
    "diffeomorphism_type": "T^7"
  },
  "spatiotemporal_addendum": {
    "normal_coordinates": "Delta_i(x,t) = norm(y_(2i:2i+1)) - r_i(t), y = Q(t)^T(x-c(t))",
    "exact_core_distance": "delta(x,t) = norm(Delta(x,t)) = dist(x,K_t)",
    "tubular_sdf": "D_tau(x,t) = delta(x,t) - tau(t)",
    "regularity_guard": "0 < tau(t) < inf_{i,t} r_i(t)",
    "core_worldvolume": "Delta^{-1}(0) ~= T^7 x I",
    "shell_worldvolume": "D_tau^{-1}(0) ~= T^7 x S^6 x I",
    "dimensions": {
      "core_worldvolume": 8,
      "shell_spatial": 13,
      "shell_worldvolume": 14
    },
    "eikonal": "norm(grad_x D_tau) = 1 in the regular band",
    "normal_velocity": "V_n = -partial_t D_tau on D_tau=0",
    "little_o_clause": "norm(D_hat_h-D_tau)_{L-infinity(B)} = o(1) as h -> 0",
    "complexity_scope": "One fixed seven-factor query is O(7)=O(1) relative to variable scene size; rendering remains O(P*S).",
    "proof_assistant_checked": false
  },
