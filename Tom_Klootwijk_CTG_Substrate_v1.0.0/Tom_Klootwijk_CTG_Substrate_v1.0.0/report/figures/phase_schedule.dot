digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.2, nodesep=0.16, ranksep=0.3, fontname="Helvetica", label="Normative TK-CTG evaluation order", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, margin="0.09,0.08", color="#183746", penwidth=1.1, width=0.82];
  edge [color="#687a82", penwidth=1.1, arrowsize=0.65];
  p0 [label="0\nparse", fillcolor="#eef2f5"];
  p1 [label="1\nnormalize", fillcolor="#e8f5f5"];
  p2 [label="2\nresolve", fillcolor="#f1eef8"];
  p3 [label="3\nconstruct", fillcolor="#fff6dc"];
  p4 [label="4\nevolve /\ntransform", fillcolor="#fff0ea"];
  p5 [label="5\nsupport", fillcolor="#eaf5ec"];
  p6 [label="6\ncompatibility", fillcolor="#f1eef8"];
  p7 [label="7\nguard /\ncertify", fillcolor="#fff0ea"];
  p8 [label="8\ntransition", fillcolor="#fff6dc"];
  p9 [label="9\nlineage", fillcolor="#eaf5ec"];
  p0->p1->p2->p3->p4->p5->p6->p7->p8->p9;
  reject [shape=note, label="Reject before execution:\nduplicate ID | unknown reference | bad SHA-256 | cycle | schema/profile mismatch", fillcolor="#fffbe9", color="#b48b20"];
  reject -> p2 [style=dashed, arrowhead=none];
}
