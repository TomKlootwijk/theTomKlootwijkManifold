  "metadata": {
    "title": "Tom Klootwijk Chrono-Topological-Geometric Substrate and Manifold",
    "version_date": "2026-08-22",
    "requester_attribution": {
      "name": "Tom Klootwijk",
      "identifier": "NL200678942",
      "date_string": "10-07-1990",
      "country_marker": "NL",
      "status": "requester-supplied-unverified",
      "mathematical_role": "provenance metadata only"
    },
    "formal_decision": "The named manifold is a hybrid stratified quotient state space; regular strata are smooth manifolds only when the declared gluing and transition maps satisfy the regularity conditions.",
    "evidence_boundary": "No claim of physical causation, universal compression, zero VRAM, constant-time rendering, authorship priority, patent status, identity verification or navigation-grade orbital accuracy."
  },
  "phase_schedule": [
    {
      "phase": 0,
      "id": "parse",
      "rule": "Parse literals, schemas, profiles and binary headers."
    },
    {
      "phase": 1,
      "id": "normalize",
      "rule": "Normalize units, sign conventions, dimensions and profile versions."
    },
    {
      "phase": 2,
      "id": "resolve",
      "rule": "Resolve definition references, verify SHA-256 content addresses and topologically order dependencies."
    },
    {
      "phase": 3,
      "id": "construct",
      "rule": "Construct geometric objects, addresses, seeds, charts and timeline nodes."
    },
    {
      "phase": 4,
      "id": "evolve_transform",
      "rule": "Evaluate flows/predictors and apply ordered hinges, gluing and coordinate transforms."
    },
    {
      "phase": 5,
      "id": "support",
      "rule": "Apply cheap local support predicates."
    },
    {
      "phase": 6,
      "id": "compatibility",
      "rule": "Apply sheet, route, branch, profile and policy compatibility."
    },
    {
      "phase": 7,
      "id": "guard_certify",
      "rule": "Solve or bracket relation roots and certify residual, direction, confidence and numerical margin."
    },
    {
      "phase": 8,
      "id": "transition",
      "rule": "Commit topology/mode transitions atomically; continuous field morphs do not change topology before this phase."
    },
    {
      "phase": 9,
      "id": "lineage",
      "rule": "Append ordered lineage, event records, novelty and implementation trace."
    }
  ],
  "profiles": {
    "default_ambient_dimension": 3,
    "time_domain": "declared interval or discrete monotone sample set embedded in R",
